<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">{{ 'Edit your siret API configuration.'|trans({}, 'siretmanagement.bo.default') }}</h5>
    </div>
    <div class="card-body">
        {{ form_start(form, {action: path('_cofiguration_siret'), method: 'POST', attr: {enctype: 'multipart/form-data'}}) }}

        <input type="hidden" name="{{ form.vars.full_name }}[success_url]" value="{{ path('admin.module.configure', {module_code: 'SiretManagement'}) }}">
        <input type="hidden" name="{{ form.vars.full_name }}[error_url]" value="{{ path('admin.module.configure', {module_code: 'SiretManagement'}) }}">

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input{{ form.api_check_disabled.vars.errors|length ? ' is-invalid' : '' }}"
                           type="checkbox"
                           id="api_check_disabled"
                           name="{{ form.api_check_disabled.vars.full_name }}"
                           value="1"
                           {{ form.api_check_disabled.vars.data ? 'checked' : '' }}>
                    {% do form.api_check_disabled.setRendered %}
                    <label class="form-check-label" for="api_check_disabled">
                        {{ form.api_check_disabled.vars.label }}
                    </label>
                    {% if form.api_check_disabled.vars.label_attr.help is defined %}
                        <div class="form-text">{{ form.api_check_disabled.vars.label_attr.help }}</div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                {{ form_label(form.api_key, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.api_key, {attr: {class: 'form-control' ~ (form.api_key.vars.errors|length ? ' is-invalid' : '')}}) }}
                {% if form.api_key.vars.label_attr.help is defined %}
                    <div class="form-text">{{ form.api_key.vars.label_attr.help }}</div>
                {% endif %}
                {{ form_errors(form.api_key) }}
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input{{ form.use_siret.vars.errors|length ? ' is-invalid' : '' }}"
                           type="checkbox"
                           id="use_siret"
                           name="{{ form.use_siret.vars.full_name }}"
                           value="1"
                           {{ form.use_siret.vars.data ? 'checked' : '' }}>
                    {% do form.use_siret.setRendered %}
                    <label class="form-check-label" for="use_siret">
                        {{ form.use_siret.vars.label }}
                    </label>
                    {% if form.use_siret.vars.label_attr.help is defined %}
                        <div class="form-text">{{ form.use_siret.vars.label_attr.help }}</div>
                    {% endif %}
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input{{ form.siret_required.vars.errors|length ? ' is-invalid' : '' }}"
                           type="checkbox"
                           id="siret_required"
                           name="{{ form.siret_required.vars.full_name }}"
                           value="1"
                           {{ form.siret_required.vars.data ? 'checked' : '' }}>
                    {% do form.siret_required.setRendered %}
                    <label class="form-check-label" for="siret_required">
                        {{ form.siret_required.vars.label }}
                    </label>
                    {% if form.siret_required.vars.label_attr.help is defined %}
                        <div class="form-text">{{ form.siret_required.vars.label_attr.help }}</div>
                    {% endif %}
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input{{ form.use_tva_intra.vars.errors|length ? ' is-invalid' : '' }}"
                           type="checkbox"
                           id="use_tva_intra"
                           name="{{ form.use_tva_intra.vars.full_name }}"
                           value="1"
                           {{ form.use_tva_intra.vars.data ? 'checked' : '' }}>
                    {% do form.use_tva_intra.setRendered %}
                    <label class="form-check-label" for="use_tva_intra">
                        {{ form.use_tva_intra.vars.label }}
                    </label>
                    {% if form.use_tva_intra.vars.label_attr.help is defined %}
                        <div class="form-text">{{ form.use_tva_intra.vars.label_attr.help }}</div>
                    {% endif %}
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input{{ form.tva_intra_required.vars.errors|length ? ' is-invalid' : '' }}"
                           type="checkbox"
                           id="tva_intra_required"
                           name="{{ form.tva_intra_required.vars.full_name }}"
                           value="1"
                           {{ form.tva_intra_required.vars.data ? 'checked' : '' }}>
                    {% do form.tva_intra_required.setRendered %}
                    <label class="form-check-label" for="tva_intra_required">
                        {{ form.tva_intra_required.vars.label }}
                    </label>
                    {% if form.tva_intra_required.vars.label_attr.help is defined %}
                        <div class="form-text">{{ form.tva_intra_required.vars.label_attr.help }}</div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="row" id="vat-existence-check-block">
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input{{ form.vat_api_check_enabled.vars.errors|length ? ' is-invalid' : '' }}"
                           type="checkbox"
                           id="vat_api_check_enabled"
                           name="{{ form.vat_api_check_enabled.vars.full_name }}"
                           value="1"
                           {{ form.vat_api_check_enabled.vars.data ? 'checked' : '' }}>
                    {% do form.vat_api_check_enabled.setRendered %}
                    <label class="form-check-label" for="vat_api_check_enabled">
                        {{ form.vat_api_check_enabled.vars.label }}
                    </label>
                    {% if form.vat_api_check_enabled.vars.label_attr.help is defined %}
                        <div class="form-text">{{ form.vat_api_check_enabled.vars.label_attr.help }}</div>
                    {% endif %}
                </div>
                <p class="form-text">
                    {{ 'This check is powered by VIES, the European Commission\'s official VAT validation service. It is free and requires no account or token.'|trans({}, 'siretmanagement.bo.default') }}
                    <br>
                    <a href="https://ec.europa.eu/taxation_customs/vies/" target="_blank" rel="noopener noreferrer">
                        {{ 'Learn more about VIES'|trans({}, 'siretmanagement.bo.default') }}
                    </a>
                </p>
            </div>
            <div class="col-md-6">
                <button type="button" id="test-vat-api-button" class="btn btn-outline-secondary">
                    {{ 'Test API availability'|trans({}, 'siretmanagement.bo.default') }}
                </button>
                <div id="test-vat-api-result" class="mt-1"></div>

                <div class="mt-3">
                    <label for="test-vat-number-input" class="form-label">
                        {{ 'Test with a real VAT number'|trans({}, 'siretmanagement.bo.default') }}
                    </label>
                    <input type="text" id="test-vat-number-input" class="form-control" placeholder="FR51306138900">
                    <p class="form-text">
                        {{ 'Examples of real, valid VAT numbers you can try: %examples'|trans({'%examples': 'FR51306138900 (Decathlon), BE0417497106 (AB InBev), FR14652014051 (Carrefour)'}, 'siretmanagement.bo.default') }}
                    </p>
                    <button type="button" id="test-vat-number-button" class="btn btn-outline-secondary mt-1">
                        {{ 'Test'|trans({}, 'siretmanagement.bo.default') }}
                    </button>
                    <div id="test-vat-number-result" class="mt-1"></div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save me-1"></i>
                {{ 'Save'|trans({}, 'siretmanagement.bo.default') }}
            </button>
            <a href="{{ path('admin.module') }}" class="btn btn-secondary">
                {{ 'Cancel'|trans({}, 'siretmanagement.bo.default') }}
            </a>
        </div>

        {{ form_rest(form) }}
        {{ form_end(form, {render_rest: false}) }}
    </div>
</div>

<script>
    (function () {
        var useTvaIntraCheckbox = document.getElementById('use_tva_intra');
        var vatExistenceCheckBlock = document.getElementById('vat-existence-check-block');

        function toggleVatExistenceCheckBlock() {
            vatExistenceCheckBlock.style.display = useTvaIntraCheckbox.checked ? '' : 'none';
        }

        if (useTvaIntraCheckbox && vatExistenceCheckBlock) {
            toggleVatExistenceCheckBlock();
            useTvaIntraCheckbox.addEventListener('change', toggleVatExistenceCheckBlock);
        }
    })();

    (function () {
        function linkUseAndRequired(useId, requiredId) {
            var useCheckbox = document.getElementById(useId);
            var requiredCheckbox = document.getElementById(requiredId);

            if (!useCheckbox || !requiredCheckbox) {
                return;
            }

            function syncRequiredState() {
                requiredCheckbox.disabled = !useCheckbox.checked;

                if (!useCheckbox.checked) {
                    requiredCheckbox.checked = false;
                }
            }

            syncRequiredState();
            useCheckbox.addEventListener('change', syncRequiredState);
        }

        linkUseAndRequired('use_siret', 'siret_required');
        linkUseAndRequired('use_tva_intra', 'tva_intra_required');
    })();

    document.getElementById('test-vat-api-button').addEventListener('click', function () {
        const resultBox = document.getElementById('test-vat-api-result');
        resultBox.textContent = '...';

        fetch('{{ path('_configuration_siret_test_vat_api') }}', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) {
                return response.json();
            })
            .then(function (result) {
                resultBox.textContent = result.message;
                resultBox.className = 'mt-1 ' + (result.available ? 'text-success' : 'text-danger');
            })
            .catch(function () {
                resultBox.textContent = '{{ 'Test failed'|trans({}, 'siretmanagement.bo.default') }}';
                resultBox.className = 'mt-1 text-danger';
            });
    });

    document.getElementById('test-vat-number-button').addEventListener('click', function () {
        const resultBox = document.getElementById('test-vat-number-result');
        const vatNumber = document.getElementById('test-vat-number-input').value;
        resultBox.textContent = '...';

        fetch('{{ path('_configuration_siret_test_vat_number') }}?vat_number=' + encodeURIComponent(vatNumber), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) {
                return response.json();
            })
            .then(function (result) {
                resultBox.textContent = result.message;

                if (!result.success) {
                    resultBox.className = 'mt-1 text-danger';
                } else if (!result.found) {
                    resultBox.className = 'mt-1 text-warning';
                } else {
                    resultBox.className = 'mt-1 text-success';
                }
            })
            .catch(function () {
                resultBox.textContent = '{{ 'Test failed'|trans({}, 'siretmanagement.bo.default') }}';
                resultBox.className = 'mt-1 text-danger';
            });
    });
</script>
